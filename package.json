{
  "name": "phaser4-ts-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Starter template for browser games on Phaser 4 and TypeScript",
  "license": "MIT",
  "author": "Monax",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "dev:yandex": "vite --mode yandex",
    "dev:crazygames": "vite --mode crazygames",
    "dev:poki": "vite --mode poki",
    "build": "tsc --noEmit && vite build",
    "build:yandex": "tsc --noEmit && vite build --mode yandex",
    "build:crazygames": "tsc --noEmit && vite build --mode crazygames",
    "build:poki": "tsc --noEmit && vite build --mode poki",
    "build:all": "tsc --noEmit && vite build && vite build --mode yandex && vite build --mode crazygames && vite build --mode poki",
    "preview": "vite preview",
    "zip": "node scripts/zip.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "dependencies": {
    "@fontsource/ubuntu": "^5.3.0",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/ysdk": "^1.2.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "fflate": "^0.8.3",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
